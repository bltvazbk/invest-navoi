# Telegram notifications for the enquiry form.
# Set these in Netlify → Site settings → Environment variables (NOT committed).
# For local testing with `netlify dev`, copy this file to `.env` and fill it in.

# Bot token from @BotFather (keep secret; rotate with /revoke if it leaks)
TELEGRAM_BOT_TOKEN=

# Telegram user or chat id that should receive enquiries
TELEGRAM_CHAT_ID=1087942416
